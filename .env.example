# First In Exeter member bot - copy this file to .env and fill it in.
# .env is git-ignored. Never paste these values into chat, logs or commits.

# --- Telegram ---------------------------------------------------------
# A NEW bot from @BotFather, not the alert bot's token.
BOT_TOKEN=
# The bot's @username without the @ (used for links, never hard-coded).
BOT_USERNAME=
# Comma-separated Telegram user IDs, owner first. Example: 123456789,987654321
ADMIN_IDS=

# --- Channels ---------------------------------------------------------
# Paid channel ID, starts with -100
PAID_CHANNEL_ID=
# Invite link for the paid channel created with "Request admin approval" ON
PAID_JOIN_REQUEST_LINK=
# Public free channel link, e.g. https://t.me/yourfreechannel
FREE_CHANNEL_LINK=

# --- Trial / access ---------------------------------------------------
TRIAL_DAYS=14
PAST_DUE_GRACE_HOURS=72
# Keep false until you have checked several dry runs.
REMOVALS_ENABLED=false
MAX_REMOVALS_PER_SWEEP=5

# --- Stripe (not needed until phase 3; test-mode keys only) -----------
# Restricted key, rk_test_... (sk_test_... also accepted). Live keys are rejected.
STRIPE_API_KEY=
# price_...
STRIPE_PRICE_ID=
# Defaults to https://t.me/<BOT_USERNAME> when left empty
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# --- Display ----------------------------------------------------------
TIMEZONE=Europe/London
# Shown in /terms, e.g. @YourSupportHandle (optional until phase 2)
SUPPORT_CONTACT=
DB_PATH=data/first-in.db
