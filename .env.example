# First In Exeter member bot - copy this file to .env and fill it in.
# .env is git-ignored. Never paste these values into chat, logs or commits.

# --- Telegram ---------------------------------------------------------
# A NEW bot from @BotFather, not the alert bot's token.
BOT_TOKEN=
# The bot's @username without the @ (used for links, never hard-coded).
BOT_USERNAME=
# Comma-separated Telegram user IDs, owner first. Example: 123456789,987654321
ADMIN_IDS=

# --- Channels ---------------------------------------------------------
# Paid channel ID, starts with -100
PAID_CHANNEL_ID=
# Invite link for the paid channel created with "Request admin approval" ON
PAID_JOIN_REQUEST_LINK=
# Public free channel link, e.g. https://t.me/yourfreechannel
FREE_CHANNEL_LINK=

# --- Trial / access ---------------------------------------------------
# Length of the Stripe free trial (card required, charged automatically after).
# At least 3: Checkout needs a fixed trial end 48 hours or more ahead. For a fast
# run through the whole cycle use scripts/stripe_test_clock.py instead.
TRIAL_DAYS=14
# How many days before the first charge the first trial reminder is sent (a last-day
# reminder goes out about 3 hours before regardless). Each is sent once, and not to
# anyone who has cancelled.
TRIAL_REMINDER_DAYS_BEFORE=3
PAST_DUE_GRACE_HOURS=72
# Keep false until you have checked several dry runs.
REMOVALS_ENABLED=false
MAX_REMOVALS_PER_SWEEP=5

# --- Stripe (test-mode keys only) ---------------------------------------
# Needed for the free trial and subscriptions. With either value empty the bot
# still runs, and the trial/subscribe buttons say payments aren't set up yet.
# Restricted key, rk_test_... (sk_test_... also accepted). Live keys are rejected.
# Permissions: Checkout Sessions write, Customers write, Subscriptions read,
# Customer Portal write, Disputes read, Charges read (the daily disputes check
# reads each dispute's charge) and Prices read. The check
# (.venv/bin/python -m first_in_bot check) tests the read side of these.
STRIPE_API_KEY=
# The recurring price_... ID. Its amount is read from Stripe at startup for messages.
STRIPE_PRICE_ID=
# Where Stripe sends people after checkout. Defaults to https://t.me/<BOT_USERNAME>
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# --- Display ----------------------------------------------------------
TIMEZONE=Europe/London
# Shown in /terms and when /manage can't open the portal, e.g. @YourSupportHandle (optional)
SUPPORT_CONTACT=
DB_PATH=data/first-in.db

# --- Backups ----------------------------------------------------------
# Every night at 03:30 (TIMEZONE) the bot saves a copy of the database here as
# first-in-YYYY-MM-DD.db (first-in-YYYY-MM-DD-2.db and so on if that day's file is
# already there: it never overwrites one). Relative to the folder the bot runs in,
# like DB_PATH. They stay on the same machine, so download one now and then.
BACKUP_DIR=backups
# How many daily backups to keep (at least 1). Older ones are deleted.
BACKUP_KEEP=14

# --- Test clocks (only for scripts/stripe_test_clock.py, optional) -------
# A TEST-mode key with: Test clocks write, Customers write, Payment methods write,
# Subscriptions write and Invoices write (payment_recovered pays an open invoice).
# The bot itself never uses it.
STRIPE_TEST_CLOCK_KEY=
